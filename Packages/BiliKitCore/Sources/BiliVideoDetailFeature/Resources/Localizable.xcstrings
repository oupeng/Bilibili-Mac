    "从热门或搜索结果中选择视频后，这里会显示详情与播放器。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a video from Popular or Search to see its details and player here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人気または検索結果から動画を選ぶと、詳細とプレーヤーがここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从热门或搜索结果中选择视频后，这里会显示详情与播放器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從熱門或搜尋結果選擇影片後，詳細資訊與播放器會顯示在這裡。"
          }
        }
      }
    },
